"┌Files──────────────────┐┏guide.md━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓"
"│› guide.md             │┃▌ # Guide                                                                ┃"
"│  notes.md   ┏Help━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓─────────────┃"
"│  todo.md    ┃ Tab / Shift-Tab  next / previous panel                               ┃             ┃"
"└─────────────┃ ↑ ↓              move the selection or the list cursor               ┃ent panel    ┃"
"┌Outline──────┃ PgUp PgDn        scroll a page                                       ┃             ┃"
"│› Guide      ┃ Home End         go to the start / end                               ┃             ┃"
"│    Install  ┃ Enter            follow the link / go to the heading / open the file ┃             ┃"
"│    Usage    ┃ ← →              choose a link in the selected block                 ┃─────────────┃"
"│      Options┃ Backspace        go back                                             ┃             ┃"
"│             ┃ /                search (Enter: done, Esc: cancel)                   ┃             ┃"
"│             ┃ >                query (css: or jq: for those syntaxes)              ┃             ┃"
"│             ┃ n / N            next / previous match                               ┃             ┃"
"│             ┃ Shift-← →        promote / demote the section                        ┃─────────────┃"
"│             ┃ Alt-↑ ↓          move the section up / down                          ┃             ┃"
"│             ┃ d / Delete       delete the section                                  ┃             ┃"
"│             ┃ u / Ctrl-r       undo / redo                                         ┃             ┃"
"│             ┃ w                save                                                ┃             ┃"
"│             ┃ e                edit in $VISUAL / $EDITOR                           ┃             ┃"
"│             ┃ R                reload from disk (u undoes it)                      ┃             ┃"
"│             ┃ o                toggle the outline                                  ┃             ┃"
"│             ┃ ?                toggle this help                                    ┃             ┃"
"│             ┃ Esc              close this help / clear the matches                 ┃             ┃"
"│             ┃ q / Ctrl-c       quit (q asks if there are unsaved edits)            ┃             ┃"
"└─────────────┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛━━━━━━━━━━━━━┛"
" guide.md (1/3)                                                                      ? help  q quit "
