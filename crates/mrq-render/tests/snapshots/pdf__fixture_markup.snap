// Generated by mrq: the theme as set and show rules, helpers, then the body.
#set document(title: "PDF fixture")
#set page(paper: "a4", margin: 2.5cm, fill: rgb("#ffffff"))
#set text(font: ("Libertinus Serif",), size: 11pt, fill: rgb("#000000"))
#set par(leading: 0.7em, spacing: 1.2em)
#show heading: set text(font: ("Libertinus Serif",), fill: rgb("#000000"))
#show heading: set block(above: 1.4em, below: 0.8em)
#show heading.where(level: 1): set text(size: 1.8em, weight: 700)
#show heading.where(level: 2): set text(size: 1.4em, weight: 700)
#show heading.where(level: 3): set text(size: 1.2em, weight: 700)
#show heading.where(level: 4): set text(size: 1em, weight: 700)
#show heading.where(level: 5): set text(size: 1em, weight: 700, style: "italic")
#show heading.where(level: 6): set text(size: 1em, weight: 400, style: "italic")
#show link: set text(fill: rgb("#1f3f7f"))
#show raw: set text(font: ("DejaVu Sans Mono",))
#show raw.where(block: false): it => box(fill: rgb("#f7f7f7"), inset: (x: 2pt), outset: (y: 2pt), radius: 2pt, text(fill: rgb("#000000"), it))
#set table(stroke: 0.5pt + rgb("#999999"), inset: 6pt)
#set footnote.entry(separator: line(length: 30%, stroke: 0.5pt + rgb("#999999")))
#show footnote.entry: set text(fill: rgb("#555555"))
#let mrq-code(fill: none, color: none, lines) = block(width: 100%, fill: fill, inset: 8pt, radius: 3pt, {
  set text(font: ("DejaVu Sans Mono",), size: 0.85em, fill: color)
  set par(justify: false, leading: 0.5em)
  lines.map(line => line.map(((text, fill, bold, italic, underline)) => {
    let span = std.text(fill: if fill == none { color } else { fill }, weight: if bold { "bold" } else { "regular" }, style: if italic { "italic" } else { "normal" }, text)
    if underline { std.underline(span) } else { span }
  }).join()).join(linebreak())
})
#let mrq-quote(body) = block(stroke: (left: 2pt + rgb("#999999")), inset: (left: 10pt, y: 2pt), text(fill: rgb("#555555"), body))
#let mrq-alert(color, title, body) = block(width: 100%, stroke: (left: 3pt + color), inset: (left: 10pt, y: 4pt), {
  if title != none { block(below: 0.6em, text(fill: color, weight: "bold", title)) }
  body
})
#let mrq-rule() = line(length: 100%, stroke: 0.5pt + rgb("#999999"))
#let mrq-task(done) = box(text(font: ("DejaVu Sans Mono",), if done [☑] else [☐]))
#let mrq-tag(body) = text(fill: rgb("#1f3f7f"), body)
#let mrq-image(path, alt: none) = box(layout(size => {
  let img = image(path, alt: alt)
  if measure(img).width > size.width { image(path, alt: alt, width: size.width) } else { img }
}))
#let mrq-diagram(path) = align(center, mrq-image(path))
// --- body
#heading(level: 1)[The PDF backend] #label("the-pdf-backend")

A paragraph with #emph[emphasis], #strong[strong text], #strike[strikethrough], #raw("inline code"), a #link("https://example.com/docs")[link] and an autolink #link("https://example.org")[https\:\/\/example\.org]\. Typst\'s markup characters stay literal\: \# \$ \* \_ \` \< \> \@ \[ \] \/ \\ \= \- \+ \~ \"quotes\" and
\= at a line start\.#linebreak()
After a hard break, a footnote#footnote[The footnote text with a #link("https://example.net")[link]\.]#label("mrq-footnote:note") and the same one again#footnote(label("mrq-footnote:note"))\. See #link(label("tables"))[the table]\.

#heading(level: 2)[Lists] #label("lists")

#list(tight: true,
  [First item],
  [Second item

#list(tight: true,
  [Nested item],
)],
  [#mrq-task(false) An open task],
  [#mrq-task(true) A done task],
)

#enum(tight: true, start: 3,
  [Three],
  [Four],
)

#heading(level: 2)[Quotes and alerts] #label("quotes-and-alerts")

#mrq-quote[
A blockquote with #emph[emphasis]\.
]

#mrq-alert(rgb("#b35900"), [Warning])[
Critical content demanding attention\.
]

#heading(level: 2)[Code] #label("code")

#mrq-code(fill: rgb("#ffffff"), color: rgb("#323232"), (
  (("fn", rgb("#a71d5d"), true, false, false), (" ", none, false, false, false), ("main", rgb("#795da3"), true, false, false), ("() {", none, false, false, false),),
  (("    println!(", none, false, false, false), ("\"Hello, ", rgb("#183691"), false, false, false), ("{}", rgb("#0086b3"), false, false, false), ("!\"", rgb("#183691"), false, false, false), (", ", none, false, false, false), ("\"world\"", rgb("#183691"), false, false, false), (");", none, false, false, false),),
  (("}", none, false, false, false),),
))

#mrq-code(fill: rgb("#f7f7f7"), color: rgb("#000000"), (
  (("plain code", none, false, false, false),),
  (("    indented line", none, false, false, false),),
))

#mrq-diagram("/assets/1.svg")

#heading(level: 2)[Tables] #label("tables")

#table(
  columns: 3,
  align: (left, center, right,),
  table.header([#strong[Left]], [#strong[Center]], [#strong[Right]]),
  [alpha], [#raw("beta")], [1],
  [#emph[gamma]], [delta], [22],
)

#heading(level: 2)[Math] #label("math")

Inline $x^(2) + y_(1) = frac(a, b)$ and display\:

$ sum_(i = 1)^(n) alpha_(i) <= sqrt(z) $

#heading(level: 2)[Images] #label("images")

#mrq-image("/assets/2.svg", alt: "The logo")

#mrq-rule()
