---
source: crates/mrq-render/tests/html.rs
expression: renderer.stylesheet()
---
html { font-size: 16px; color: #d4d4d4; background-color: #1e1e1e; }
body { margin: 0; font-family: system-ui, sans-serif; line-height: 1.5; }
main { max-width: 50rem; margin: 0 auto; padding: 2rem 1rem; }
a { color: #6cb6ff; }
h1 { font-size: 2em; font-weight: 700; font-style: normal; color: #f0f0f0; border-bottom: 1px solid #3c3c3c; padding-bottom: 0.3em; }
h2 { font-size: 1.5em; font-weight: 700; font-style: normal; color: #f0f0f0; border-bottom: 1px solid #3c3c3c; padding-bottom: 0.3em; }
h3 { font-size: 1.25em; font-weight: 700; font-style: normal; color: #f0f0f0; }
h4 { font-size: 1em; font-weight: 700; font-style: normal; color: #f0f0f0; }
h5 { font-size: 0.875em; font-weight: 700; font-style: normal; color: #f0f0f0; }
h6 { font-size: 0.85em; font-weight: 700; font-style: normal; color: #f0f0f0; }
hr { border: 0; border-top: 1px solid #3c3c3c; }
blockquote { margin-left: 0; padding: 0 1em; color: #9a9a9a; border-left: 0.25em solid #3c3c3c; }
code, kbd, samp, pre { font-family: ui-monospace, monospace; font-size: 0.9em; }
code { color: #d4d4d4; background-color: #2a2a2a; padding: 0.1em 0.3em; border-radius: 0.25em; }
pre { color: #d4d4d4; background-color: #2a2a2a; padding: 0.75em 1em; overflow-x: auto; border-radius: 0.25em; line-height: 1.4; }
pre code { color: inherit; background: none; padding: 0; font-size: inherit; }
table { border-collapse: collapse; }
th, td { border: 1px solid #3c3c3c; padding: 0.3em 0.75em; }
img { max-width: 100%; }
mark { background-color: #d299223f; }
dt { font-weight: bold; }
li:has(> input[type="checkbox"]:first-child), li:has(> p:first-child > input[type="checkbox"]:first-child) { list-style: none; }
li > input[type="checkbox"]:first-child, li > p:first-child > input[type="checkbox"]:first-child { margin: 0 0.4em 0 -1.3em; }
.tag { color: #6cb6ff; }
.admonition { --admonition-color: #4493f8; margin: 1em 0; padding: 0 1em; border-left: 0.25em solid var(--admonition-color); }
.admonition-title { font-weight: bold; color: var(--admonition-color); }
summary.admonition-title { margin: 1em 0; cursor: pointer; }
.admonition.note, .admonition.info, .admonition.todo, .admonition.abstract, .admonition.summary, .admonition.tldr, .admonition.quote, .admonition.cite, .admonition.seealso { --admonition-color: #4493f8; }
.admonition.tip, .admonition.hint, .admonition.success, .admonition.check, .admonition.done { --admonition-color: #3fb950; }
.admonition.important, .admonition.example { --admonition-color: #ab7df8; }
.admonition.warning, .admonition.attention, .admonition.question, .admonition.help, .admonition.faq { --admonition-color: #d29922; }
.admonition.caution, .admonition.danger, .admonition.error, .admonition.failure, .admonition.fail, .admonition.missing, .admonition.bug { --admonition-color: #f85149; }
.footnotes { color: #9a9a9a; font-size: 0.9em; border-top: 1px solid #3c3c3c; }
math[display="block"] { margin: 1em 0; }
/*
 * theme "Base16 Ocean Dark" generated by syntect
 */

