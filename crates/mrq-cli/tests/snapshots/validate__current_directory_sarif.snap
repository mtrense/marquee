                },
                "region": {
                  "startLine": 2,
                  "startColumn": 8,
                  "endLine": 2,
                  "endColumn": 9
                }
              }
            }
          ]
        },
        {
          "ruleId": "stale-toc",
          "ruleIndex": 7,
          "level": "warning",
          "message": {
            "text": "table of contents is out of date\n\nhelp: run `mrq toc --insert` to regenerate it"
          },
          "locations": [
