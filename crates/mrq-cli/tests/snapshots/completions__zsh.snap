---
source: crates/mrq-cli/tests/completions.rs
expression: "completions(\"zsh\")"
---
#compdef mrq

autoload -U is-at-least

_mrq() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--config=[Use this config file instead of discovering \`.mrq.yaml\`]:PATH:_files' \
'--flavor=[Markdown flavor \[default\: frontmatter \`mrq.flavor\`, then config, then gfm\]]:FLAVOR:((commonmark\:"Strict CommonMark"
gfm\:"GitHub Flavored Markdown"
obsidian\:"Obsidian\: gfm + wikilinks, embeds, callouts, tags, math, comments"
mkdocs\:"MkDocs\: gfm + admonitions, heading attributes, definition lists, math"))' \
'--color=[When to use colors]:WHEN:((auto\:"Colors when writing to a terminal and NO_COLOR is unset"
always\:"Always emit colors"
never\:"Never emit colors"))' \
'--format=[Diagnostics output format \[default\: human, or github when GITHUB_ACTIONS=true\]]:FORMAT:((human\:"Human-readable, with source snippets"
json\:"A single JSON array"
ndjson\:"One JSON object per line"
sarif\:"SARIF 2.1.0"
github\:"GitHub Actions workflow annotations"))' \
'(-v --verbose)*-q[Print less output; repeat for even less]' \
'(-v --verbose)*--quiet[Print less output; repeat for even less]' \
'*-v[Print more output; repeat for even more]' \
'*--verbose[Print more output; repeat for even more]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_mrq_commands" \
"*::: :->mrq" \
&& ret=0
    case $state in
    (mrq)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:mrq-command-$line[1]:"
        case $line[1] in
            (toc)
_arguments "${_arguments_options[@]}" : \
'--depth=[Only include headings up to this level]:N:_default' \
'--config=[Use this config file instead of discovering \`.mrq.yaml\`]:PATH:_files' \
'--flavor=[Markdown flavor \[default\: frontmatter \`mrq.flavor\`, then config, then gfm\]]:FLAVOR:((commonmark\:"Strict CommonMark"
gfm\:"GitHub Flavored Markdown"
obsidian\:"Obsidian\: gfm + wikilinks, embeds, callouts, tags, math, comments"
mkdocs\:"MkDocs\: gfm + admonitions, heading attributes, definition lists, math"))' \
'--color=[When to use colors]:WHEN:((auto\:"Colors when writing to a terminal and NO_COLOR is unset"
always\:"Always emit colors"
never\:"Never emit colors"))' \
'--format=[Diagnostics output format \[default\: human, or github when GITHUB_ACTIONS=true\]]:FORMAT:((human\:"Human-readable, with source snippets"
json\:"A single JSON array"
ndjson\:"One JSON object per line"
sarif\:"SARIF 2.1.0"
github\:"GitHub Actions workflow annotations"))' \
'--json[Emit level, text, slug and source position per heading as JSON]' \
'(--json)--links[Print a nested Markdown list with anchor links]' \
'(--json)--insert[Refresh a \`<!-- mrq\:toc -->\` … \`<!-- mrq\:end -->\` block in place]' \
'--check[With --insert\: write nothing, list out-of-date files and exit 1 if there are any]' \
'(-v --verbose)*-q[Print less output; repeat for even less]' \
'(-v --verbose)*--quiet[Print less output; repeat for even less]' \
'*-v[Print more output; repeat for even more]' \
'*--verbose[Print more output; repeat for even more]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'*::paths -- Files, directories, globs, or `-` for stdin:_files' \
&& ret=0
;;
(render)
_arguments "${_arguments_options[@]}" : \
'-o+[Output format]:FORMAT:((html\:"Standalone HTML page (or body only with --fragment)"
ansi\:"Terminal output with colors and highlighting"
pdf\:"PDF via embedded Typst"
md\:"Normalized Markdown, optionally in another flavor"
json\:"Stable mdast-like AST with source positions"
man\:"roff, for man pages"))' \
'--output=[Output format]:FORMAT:((html\:"Standalone HTML page (or body only with --fragment)"
ansi\:"Terminal output with colors and highlighting"
pdf\:"PDF via embedded Typst"
md\:"Normalized Markdown, optionally in another flavor"
json\:"Stable mdast-like AST with source positions"
man\:"roff, for man pages"))' \
