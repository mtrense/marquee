module completions {

  def "nu-complete mrq flavor" [] {
    [ "commonmark" "gfm" "obsidian" "mkdocs" ]
  }

  def "nu-complete mrq color" [] {
    [ "auto" "always" "never" ]
  }

  def "nu-complete mrq format" [] {
    [ "human" "json" "ndjson" "sarif" "github" ]
  }

  # A Markdown toolkit for the terminal: verify, lint, format, query, transform, render and display Markdown
  export extern mrq [
    --config: path            # Use this config file instead of discovering `.mrq.yaml`
    --flavor: string@"nu-complete mrq flavor" # Markdown flavor [default: frontmatter `mrq.flavor`, then config, then gfm]
    --color: string@"nu-complete mrq color" # When to use colors
    --format: string@"nu-complete mrq format" # Diagnostics output format [default: human, or github when GITHUB_ACTIONS=true]
    --quiet(-q)               # Print less output; repeat for even less
    --verbose(-v)             # Print more output; repeat for even more
    --help(-h)                # Print help (see more with '--help')
    --version(-V)             # Print version
  ]

  def "nu-complete mrq toc flavor" [] {
    [ "commonmark" "gfm" "obsidian" "mkdocs" ]
  }

  def "nu-complete mrq toc color" [] {
    [ "auto" "always" "never" ]
  }

  def "nu-complete mrq toc format" [] {
    [ "human" "json" "ndjson" "sarif" "github" ]
  }

  # Print the heading outline of each file
  export extern "mrq toc" [
    --json                    # Emit level, text, slug and source position per heading as JSON
    --depth: string           # Only include headings up to this level
    --links                   # Print a nested Markdown list with anchor links
    --insert                  # Refresh a `<!-- mrq:toc -->` … `<!-- mrq:end -->` block in place
    --check                   # With --insert: write nothing, list out-of-date files and exit 1 if there are any
    --config: path            # Use this config file instead of discovering `.mrq.yaml`
    --flavor: string@"nu-complete mrq toc flavor" # Markdown flavor [default: frontmatter `mrq.flavor`, then config, then gfm]
    --color: string@"nu-complete mrq toc color" # When to use colors
    --format: string@"nu-complete mrq toc format" # Diagnostics output format [default: human, or github when GITHUB_ACTIONS=true]
    --quiet(-q)               # Print less output; repeat for even less
    --verbose(-v)             # Print more output; repeat for even more
    --help(-h)                # Print help (see more with '--help')
    ...paths: path            # Files, directories, globs, or `-` for stdin
  ]

