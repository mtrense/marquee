  }

  # Render files or stdin to HTML, ANSI, PDF, Markdown, JSON or man
  export extern "mrq render" [
    --output(-o): string@"nu-complete mrq render output" # Output format
    --style(-s): string       # Built-in theme (light, dark, github, paper) or a theme file [default: config `render.style`, then light]
    --fragment                # HTML body only, without the `<html>` wrapper and the stylesheet
    --width: string           # Terminal width for `-o ansi` [default: the terminal's, then $COLUMNS, then 80]
    --out: path               # Write to this file instead of stdout
    --out-dir: directory      # Write one file per input into this directory, named after the input (`guide.md` → `guide.html`)
    --config: path            # Use this config file instead of discovering `.mrq.yaml`
    --flavor: string@"nu-complete mrq render flavor" # Markdown flavor [default: frontmatter `mrq.flavor`, then config, then gfm]
    --color: string@"nu-complete mrq render color" # When to use colors
    --format: string@"nu-complete mrq render format" # Diagnostics output format [default: human, or github when GITHUB_ACTIONS=true]
    --quiet(-q)               # Print less output; repeat for even less
    --verbose(-v)             # Print more output; repeat for even more
    --help(-h)                # Print help (see more with '--help')
    ...paths: path            # Files, directories, globs, or `-` for stdin
  ]

