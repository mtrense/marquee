  # Apply markdownlint-compatible style rules
  export extern "mrq lint" [
    --fix                     # Apply automatic fixes in place (stdin: print the fixed text), then report what is left
    --fix-only                # Like --fix, but report nothing and exit 0 even if findings without a fix remain
    --diff                    # Do not write; print the fixes as a unified diff and exit 1 if there are any
    --rule: string            # Only run this rule, alias or tag (repeatable), even if the config turns it off
    --config: path            # Use this config file instead of discovering `.mrq.yaml`
    --flavor: string@"nu-complete mrq lint flavor" # Markdown flavor [default: frontmatter `mrq.flavor`, then config, then gfm]
