---
source: crates/mrq-cli/tests/completions.rs
expression: "completions(\"fish\")"
---
# Print an optspec for argparse to handle cmd's options that are independent of any subcommand.
function __fish_mrq_global_optspecs
    string join \n config= flavor= color= format= q/quiet v/verbose h/help V/version
end

function __fish_mrq_needs_command
    # Figure out if the current invocation already has a command.
    set -l cmd (commandline -opc)
    set -e cmd[1]
    argparse -s (__fish_mrq_global_optspecs) -- $cmd 2>/dev/null
    or return
    if set -q argv[1]
        # Also print the command, so this can be used to figure out what it is.
        echo $argv[1]
        return 1
    end
    return 0
end

function __fish_mrq_using_subcommand
    set -l cmd (__fish_mrq_needs_command)
    test -z "$cmd"
    and return 1
    contains -- $cmd[1] $argv
end

complete -c mrq -n "__fish_mrq_needs_command" -l config -d 'Use this config file instead of discovering `.mrq.yaml`' -r -F
complete -c mrq -n "__fish_mrq_needs_command" -l flavor -d 'Markdown flavor [default: frontmatter `mrq.flavor`, then config, then gfm]' -r -f -a "commonmark\t'Strict CommonMark'
gfm\t'GitHub Flavored Markdown'
obsidian\t'Obsidian: gfm + wikilinks, embeds, callouts, tags, math, comments'
mkdocs\t'MkDocs: gfm + admonitions, heading attributes, definition lists, math'"
complete -c mrq -n "__fish_mrq_needs_command" -l color -d 'When to use colors' -r -f -a "auto\t'Colors when writing to a terminal and NO_COLOR is unset'
always\t'Always emit colors'
never\t'Never emit colors'"
