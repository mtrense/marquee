---
source: crates/mrq-cli/tests/completions.rs
expression: "completions(\"bash\")"
---
_mrq() {
    local i cur prev opts cmd
    COMPREPLY=()
    if [[ "${BASH_VERSINFO[0]}" -ge 4 ]]; then
        cur="$2"
    else
        cur="${COMP_WORDS[COMP_CWORD]}"
    fi
    prev="$3"
    cmd=""
    opts=""

    for i in "${COMP_WORDS[@]:0:COMP_CWORD}"
    do
        case "${cmd},${i}" in
            ",$1")
                cmd="mrq"
                ;;
            mrq,completions)
                cmd="mrq__subcmd__completions"
                ;;
            mrq,config)
                cmd="mrq__subcmd__config"
                ;;
            mrq,diff)
                cmd="mrq__subcmd__diff"
                ;;
            mrq,fmt)
                cmd="mrq__subcmd__fmt"
                ;;
            mrq,help)
                cmd="mrq__subcmd__help"
                ;;
            mrq,interpolate)
                cmd="mrq__subcmd__interpolate"
                ;;
            mrq,lint)
                cmd="mrq__subcmd__lint"
                ;;
            mrq,lsp)
                cmd="mrq__subcmd__lsp"
                ;;
            mrq,merge)
                cmd="mrq__subcmd__merge"
                ;;
            mrq,query)
                cmd="mrq__subcmd__query"
                ;;
            mrq,render)
                cmd="mrq__subcmd__render"
                ;;
            mrq,show)
                cmd="mrq__subcmd__show"
                ;;
            mrq,split)
                cmd="mrq__subcmd__split"
                ;;
            mrq,stats)
                cmd="mrq__subcmd__stats"
                ;;
            mrq,toc)
                cmd="mrq__subcmd__toc"
                ;;
            mrq,validate)
                cmd="mrq__subcmd__validate"
                ;;
            mrq__subcmd__config,help)
                cmd="mrq__subcmd__config__subcmd__help"
                ;;
            mrq__subcmd__config,schema)
                cmd="mrq__subcmd__config__subcmd__schema"
                ;;
            mrq__subcmd__config,show)
                cmd="mrq__subcmd__config__subcmd__show"
                ;;
            mrq__subcmd__config__subcmd__help,help)
                cmd="mrq__subcmd__config__subcmd__help__subcmd__help"
                ;;
            mrq__subcmd__config__subcmd__help,schema)
                cmd="mrq__subcmd__config__subcmd__help__subcmd__schema"
                ;;
            mrq__subcmd__config__subcmd__help,show)
                cmd="mrq__subcmd__config__subcmd__help__subcmd__show"
                ;;
            mrq__subcmd__help,completions)
                cmd="mrq__subcmd__help__subcmd__completions"
                ;;
            mrq__subcmd__help,config)
                cmd="mrq__subcmd__help__subcmd__config"
                ;;
            mrq__subcmd__help,diff)
                cmd="mrq__subcmd__help__subcmd__diff"
                ;;
            mrq__subcmd__help,fmt)
                cmd="mrq__subcmd__help__subcmd__fmt"
                ;;
            mrq__subcmd__help,help)
                cmd="mrq__subcmd__help__subcmd__help"
                ;;
            mrq__subcmd__help,interpolate)
                cmd="mrq__subcmd__help__subcmd__interpolate"
                ;;
            mrq__subcmd__help,lint)
                cmd="mrq__subcmd__help__subcmd__lint"
                ;;
            mrq__subcmd__help,lsp)
                cmd="mrq__subcmd__help__subcmd__lsp"
                ;;
            mrq__subcmd__help,merge)
                cmd="mrq__subcmd__help__subcmd__merge"
                ;;
            mrq__subcmd__help,query)
                cmd="mrq__subcmd__help__subcmd__query"
                ;;
            mrq__subcmd__help,render)
                cmd="mrq__subcmd__help__subcmd__render"
                ;;
            mrq__subcmd__help,show)
                cmd="mrq__subcmd__help__subcmd__show"
                ;;
            mrq__subcmd__help,split)
                cmd="mrq__subcmd__help__subcmd__split"
                ;;
            mrq__subcmd__help,stats)
                cmd="mrq__subcmd__help__subcmd__stats"
                ;;
            mrq__subcmd__help,toc)
                cmd="mrq__subcmd__help__subcmd__toc"
                ;;
            mrq__subcmd__help,validate)
                cmd="mrq__subcmd__help__subcmd__validate"
                ;;
            mrq__subcmd__help__subcmd__config,schema)
                cmd="mrq__subcmd__help__subcmd__config__subcmd__schema"
                ;;
            mrq__subcmd__help__subcmd__config,show)
                cmd="mrq__subcmd__help__subcmd__config__subcmd__show"
                ;;
            *)
                ;;
        esac
    done

    case "${cmd}" in
        mrq)
            opts="-q -v -h -V --config --flavor --color --format --quiet --verbose --help --version toc render validate lint fmt query merge interpolate split stats diff show lsp config completions help"
            if [[ ${cur} == -* || ${COMP_CWORD} -eq 1 ]] ; then
                COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
                return 0
            fi
            case "${prev}" in
                --config)
                    local oldifs
                    if [ -n "${IFS+x}" ]; then
                        oldifs="$IFS"
                    fi
                    IFS=$'\n'
                    COMPREPLY=($(compgen -f "${cur}"))
                    if [ -n "${oldifs+x}" ]; then
                        IFS="$oldifs"
                    fi
                    if [[ "${BASH_VERSINFO[0]}" -ge 4 ]]; then
                        compopt -o filenames
                    fi
                    return 0
                    ;;
                --flavor)
                    COMPREPLY=($(compgen -W "commonmark gfm obsidian mkdocs" -- "${cur}"))
                    return 0
                    ;;
                --color)
                    COMPREPLY=($(compgen -W "auto always never" -- "${cur}"))
                    return 0
                    ;;
                --format)
                    COMPREPLY=($(compgen -W "human json ndjson sarif github" -- "${cur}"))
                    return 0
                    ;;
                *)
                    COMPREPLY=()
                    ;;
            esac
            COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
            return 0
            ;;
        mrq__subcmd__completions)
            opts="-q -v -h --config --flavor --color --format --quiet --verbose --help bash carapace elvish fish nushell powershell zsh"
            if [[ ${cur} == -* || ${COMP_CWORD} -eq 2 ]] ; then
                COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
