    "RuleSwitch": {
      "description": "`true`/`on` enables, `false`/`off` disables.",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "enum": [
            "on",
            "off"
          ]
        }
      ]
    },
    "Md001Options": {
      "description": "Options of MD001 `heading-increment`.",
      "type": "object",
      "properties": {
        "front_matter_title": {
          "description": "Regular expression (case-insensitive) for a frontmatter line that holds the\ntitle; `\"\"` ignores the frontmatter. An invalid expression matches nothing.",
          "type": "string",
          "default": "^\\s*\"?title\"?\\s*[:=]"
        }
      },
      "additionalProperties": false
    },
    "Md003Options": {
      "description": "Options of MD003 `heading-style`.",
      "type": "object",
      "properties": {
        "style": {
          "description": "Heading style.",
          "$ref": "#/$defs/HeadingStyle",
          "default": "consistent"
        }
      },
      "additionalProperties": false
    },
    "HeadingStyle": {
      "description": "A heading style of MD003.",
      "oneOf": [
        {
          "description": "Like the first heading.",
          "type": "string",
          "const": "consistent"
        },
        {
          "description": "`# Heading`",
          "type": "string",
          "const": "atx"
        },
        {
          "description": "`# Heading #`",
          "type": "string",
          "const": "atx_closed"
        },
        {
          "description": "Underlined with `===` or `---`.",
          "type": "string",
          "const": "setext"
        },
        {
          "description": "Setext for levels 1 and 2, `atx` below.",
          "type": "string",
          "const": "setext_with_atx"
        },
        {
          "description": "Setext for levels 1 and 2, `atx_closed` below.",
          "type": "string",
          "const": "setext_with_atx_closed"
        }
      ]
    },
    "Md004Options": {
      "description": "Options of MD004 `ul-style`.",
      "type": "object",
      "properties": {
        "style": {
          "description": "List style.",
          "$ref": "#/$defs/ListStyle",
          "default": "consistent"
        }
      },
      "additionalProperties": false
    },
    "ListStyle": {
      "description": "A bullet list style of MD004.",
      "oneOf": [
        {
          "description": "Like the first marker.",
          "type": "string",
          "const": "consistent"
        },
        {
          "description": "`*`",
          "type": "string",
          "const": "asterisk"
        },
        {
          "description": "`+`",
          "type": "string",
          "const": "plus"
        },
        {
          "description": "`-`",
          "type": "string",
          "const": "dash"
        },
        {
          "description": "Each nesting level differs from its parent.",
          "type": "string",
          "const": "sublist"
        }
      ]
    },
    "NoOptions": {
      "description": "Options of a rule that has none: only `{}` is accepted.",
      "type": "object",
      "additionalProperties": false
    },
    "Md007Options": {
      "description": "Options of MD007 `ul-indent`.",
      "type": "object",
      "properties": {
        "indent": {
          "description": "Spaces for indent.",
          "type": "integer",
          "format": "uint",
          "minimum": 1,
          "default": 2
        },
        "start_indented": {
          "description": "Whether to indent the first level of the list.",
          "type": "boolean",
          "default": false
        },
        "start_indent": {
          "description": "Spaces for first level indent (when `start_indented` is set); defaults to\n`indent`.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 1,
          "default": null
        }
      },
      "additionalProperties": false
    },
    "Md009Options": {
      "description": "Options of MD009 `no-trailing-spaces`.",
      "type": "object",
      "properties": {
        "br_spaces": {
          "description": "Spaces for line break (values below 2 allow none).",
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 2
        },
        "code_blocks": {
          "description": "Include code blocks.",
          "type": "boolean",
          "default": false
        },
        "list_item_empty_lines": {
          "description": "Allow spaces for empty lines in list items.",
          "type": "boolean",
          "default": false
        },
        "strict": {
          "description": "Include unnecessary breaks.",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "Md010Options": {
      "description": "Options of MD010 `no-hard-tabs`.",
      "type": "object",
      "properties": {
        "code_blocks": {
          "description": "Include code blocks.",
          "type": "boolean",
          "default": true
        },
        "ignore_code_languages": {
          "description": "Fenced code languages to ignore (ignoring case). Like markdownlint, a non-empty\nlist also skips fenced blocks without a language.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "spaces_per_tab": {
          "description": "Number of spaces for each hard tab.",
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 1
        }
      },
      "additionalProperties": false
    },
    "Md012Options": {
      "description": "Options of MD012 `no-multiple-blanks`.",
      "type": "object",
      "properties": {
        "maximum": {
          "description": "Consecutive blank lines allowed.",
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 1
        }
      },
      "additionalProperties": false
    },
    "Md013Options": {
      "description": "Options of MD013 `line-length`.",
      "type": "object",
      "properties": {
        "line_length": {
          "description": "Number of characters.",
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 80
        },
        "heading_line_length": {
          "description": "Number of characters for headings; defaults to `line_length`.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0,
          "default": null
        },
        "code_block_line_length": {
          "description": "Number of characters for code blocks; defaults to `line_length`.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0,
          "default": null
        },
        "code_blocks": {
          "description": "Include code blocks.",
          "type": "boolean",
          "default": true
        },
        "tables": {
          "description": "Include tables.",
          "type": "boolean",
          "default": true
        },
        "headings": {
          "description": "Include headings.",
          "type": "boolean",
          "default": true
        },
        "strict": {
          "description": "Strict length checking.",
          "type": "boolean",
          "default": false
        },
        "stern": {
          "description": "Stern length checking.",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "Md022Options": {
      "description": "Options of MD022 `blanks-around-headings`.",
      "type": "object",
      "properties": {
        "lines_above": {
          "description": "Blank lines above heading.",
          "$ref": "#/$defs/BlankLines",
          "default": 1
        },
        "lines_below": {
          "description": "Blank lines below heading.",
          "$ref": "#/$defs/BlankLines",
          "default": 1
        },
        "include_front_matter": {
          "description": "Include front matter content.",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "BlankLines": {
      "description": "Blank lines for every heading, or per level (index 0 for level 1; missing levels\ntake 1). `-1` turns the check off.",
      "anyOf": [
        {
          "description": "The same for every level.",
          "type": "integer",
          "format": "int64"
        },
        {
          "description": "One count per level.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "int64"
          }
        }
      ]
    },
    "Md024Options": {
      "description": "Options of MD024 `no-duplicate-heading`.",
      "type": "object",
      "properties": {
        "siblings_only": {
          "description": "Only check sibling headings.",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "Md025Options": {
      "description": "Options of MD025 `single-title`.",
      "type": "object",
      "properties": {
        "level": {
          "description": "Heading level.",
          "type": "integer",
          "format": "uint8",
          "minimum": 0,
          "maximum": 255,
          "default": 1
        },
        "front_matter_title": {
          "description": "`RegExp` for matching title in front matter; empty to ignore front matter.",
          "type": "string",
          "default": "^\\s*\"?title\"?\\s*[:=]"
        }
      },
      "additionalProperties": false
    },
    "Md026Options": {
      "description": "Options of MD026 `no-trailing-punctuation`.",
      "type": "object",
      "properties": {
        "punctuation": {
          "description": "Punctuation characters.",
          "type": "string",
          "default": ".,;:!。，；：！"
        }
      },
      "additionalProperties": false
    },
    "Md027Options": {
      "description": "Options of MD027 `no-multiple-space-blockquote`.",
      "type": "object",
      "properties": {
        "list_items": {
          "description": "Include list items.",
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "Md029Options": {
      "description": "Options of MD029 `ol-prefix`.",
      "type": "object",
      "properties": {
        "style": {
          "description": "List style.",
          "$ref": "#/$defs/OrderedListStyle",
          "default": "one_or_ordered"
        }
      },
      "additionalProperties": false
    },
    "OrderedListStyle": {
      "description": "A numbering style of MD029.",
      "oneOf": [
        {
          "description": "`ordered` if the list counts up, else `one`.",
          "type": "string",
          "const": "one_or_ordered"
        },
        {
          "description": "`1. 1. 1.`",
          "type": "string",
          "const": "one"
        },
        {
          "description": "`1. 2. 3.` (or `0. 1. 2.`)",
          "type": "string",
          "const": "ordered"
        },
        {
          "description": "`0. 0. 0.`",
          "type": "string",
          "const": "zero"
        }
      ]
    },
    "Md030Options": {
      "description": "Options of MD030 `list-marker-space`.",
      "type": "object",
      "properties": {
        "ul_single": {
          "description": "Spaces for single-line unordered list items.",
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 1
        },
        "ol_single": {
          "description": "Spaces for single-line ordered list items.",
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 1
        },
        "ul_multi": {
          "description": "Spaces for multi-line unordered list items.",
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 1
        },
        "ol_multi": {
          "description": "Spaces for multi-line ordered list items.",
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 1
        }
      },
      "additionalProperties": false
    },
    "Md031Options": {
      "description": "Options of MD031 `blanks-around-fences`.",
      "type": "object",
      "properties": {
        "list_items": {
          "description": "Include list items.",
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "Md033Options": {
      "description": "Options of MD033 `no-inline-html`.",
      "type": "object",
      "properties": {
        "allowed_elements": {
          "description": "Allowed elements.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "table_allowed_elements": {
          "description": "Allowed elements in tables; defaults to `allowed_elements`.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "default": null
        }
      },
      "additionalProperties": false
    },
    "Md035Options": {
      "description": "Options of MD035 `hr-style`.",
      "type": "object",
      "properties": {
        "style": {
          "description": "Horizontal rule style: `consistent` or the exact text, like `---`.",
          "type": "string",
          "default": "consistent"
        }
      },
      "additionalProperties": false
    },
    "Md036Options": {
      "description": "Options of MD036 `no-emphasis-as-heading`.",
      "type": "object",
      "properties": {
        "punctuation": {
          "description": "Punctuation characters.",
          "type": "string",
          "default": ".,;:!?。，；：！？"
        }
      },
      "additionalProperties": false
    },
    "Md040Options": {
      "description": "Options of MD040 `fenced-code-language`.",
      "type": "object",
      "properties": {
        "allowed_languages": {
          "description": "List of languages.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "language_only": {
          "description": "Require language only.",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "Md041Options": {
      "description": "Options of MD041 `first-line-heading`.",
      "type": "object",
      "properties": {
        "allow_preamble": {
          "description": "Allow content before first heading.",
          "type": "boolean",
          "default": false
        },
        "front_matter_title": {
          "description": "Regular expression (case-insensitive) for a frontmatter line that holds the\ntitle; `\"\"` ignores the frontmatter. An invalid expression matches nothing.",
          "type": "string",
          "default": "^\\s*\"?title\"?\\s*[:=]"
        },
        "level": {
          "description": "Heading level.",
          "type": "integer",
          "format": "uint8",
          "minimum": 0,
          "maximum": 255,
          "default": 1
        }
      },
      "additionalProperties": false
    },
    "Md043Options": {
      "description": "Options of MD043 `required-headings`.",
      "type": "object",
      "properties": {
        "headings": {
          "description": "List of headings.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "default": null
        },
        "match_case": {
          "description": "Match case of headings.",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "Md044Options": {
      "description": "Options of MD044 `proper-names`.",
      "type": "object",
      "properties": {
        "names": {
          "description": "List of proper names.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "code_blocks": {
          "description": "Include code blocks.",
          "type": "boolean",
          "default": true
        },
        "html_elements": {
          "description": "Include HTML elements.",
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "Md046Options": {
      "description": "Options of MD046 `code-block-style`.",
      "type": "object",
      "properties": {
        "style": {
          "description": "Block style.",
          "$ref": "#/$defs/CodeBlockStyle",
          "default": "consistent"
        }
      },
      "additionalProperties": false
    },
    "CodeBlockStyle": {
      "description": "A code block style of MD046.",
      "oneOf": [
        {
          "description": "Like the first code block.",
          "type": "string",
          "const": "consistent"
        },
        {
          "description": "Between fences.",
          "type": "string",
          "const": "fenced"
        },
        {
          "description": "Indented by four spaces.",
          "type": "string",
          "const": "indented"
        }
      ]
    },
    "Md048Options": {
      "description": "Options of MD048 `code-fence-style`.",
      "type": "object",
      "properties": {
        "style": {
          "description": "Code fence style.",
          "$ref": "#/$defs/FenceStyle",
          "default": "consistent"
        }
      },
      "additionalProperties": false
    },
    "FenceStyle": {
      "description": "A code fence style of MD048.",
      "oneOf": [
        {
          "description": "Like the first fence.",
          "type": "string",
          "const": "consistent"
        },
        {
          "description": "`` ``` ``",
          "type": "string",
          "const": "backtick"
        },
        {
          "description": "`~~~`",
          "type": "string",
          "const": "tilde"
        }
      ]
    },
    "Md049Options": {
      "description": "Options of MD049 `emphasis-style`.",
      "type": "object",
      "properties": {
        "style": {
          "description": "Emphasis style.",
          "$ref": "#/$defs/EmphasisStyle",
          "default": "consistent"
        }
      },
      "additionalProperties": false
    },
    "EmphasisStyle": {
      "description": "An emphasis or strong style of MD049 and MD050.",
      "oneOf": [
        {
          "description": "Like the first emphasis.",
          "type": "string",
          "const": "consistent"
        },
        {
          "description": "`*` or `**`",
          "type": "string",
          "const": "asterisk"
        },
        {
          "description": "`_` or `__`",
          "type": "string",
          "const": "underscore"
        }
      ]
    },
    "Md050Options": {
      "description": "Options of MD050 `strong-style`.",
      "type": "object",
      "properties": {
        "style": {
          "description": "Strong style.",
          "$ref": "#/$defs/EmphasisStyle",
          "default": "consistent"
        }
      },
      "additionalProperties": false
    },
    "Md051Options": {
      "description": "Options of MD051 `link-fragments`.",
      "type": "object",
      "properties": {
        "ignore_case": {
          "description": "Ignore case of fragments.",
          "type": "boolean",
          "default": false
        },
        "ignored_pattern": {
          "description": "Pattern for ignoring additional fragments; an invalid one ignores nothing.",
          "type": "string",
          "default": ""
        }
      },
      "additionalProperties": false
    },
    "Md052Options": {
      "description": "Options of MD052 `reference-links-images`.",
      "type": "object",
      "properties": {
        "ignored_labels": {
          "description": "Ignored link labels.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "x"
          ]
        },
        "shortcut_syntax": {
          "description": "Include shortcut syntax.",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "Md053Options": {
      "description": "Options of MD053 `link-image-reference-definitions`.",
      "type": "object",
      "properties": {
        "ignored_definitions": {
          "description": "Ignored definitions.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "//"
          ]
        }
      },
      "additionalProperties": false
    },
    "Md054Options": {
      "description": "Options of MD054 `link-image-style`.",
      "type": "object",
      "properties": {
        "autolink": {
          "description": "Allow autolinks.",
          "type": "boolean",
          "default": true
        },
        "inline": {
          "description": "Allow inline links and images.",
          "type": "boolean",
          "default": true
        },
        "full": {
          "description": "Allow full reference links and images.",
          "type": "boolean",
          "default": true
        },
        "collapsed": {
          "description": "Allow collapsed reference links and images.",
          "type": "boolean",
          "default": true
        },
        "shortcut": {
          "description": "Allow shortcut reference links and images.",
          "type": "boolean",
          "default": true
        },
        "url_inline": {
          "description": "Allow URLs as inline links.",
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "Md055Options": {
      "description": "Options of MD055 `table-pipe-style`.",
      "type": "object",
      "properties": {
        "style": {
          "description": "Table pipe style.",
          "$ref": "#/$defs/PipeStyle",
          "default": "consistent"
        }
      },
      "additionalProperties": false
    },
    "PipeStyle": {
      "description": "A table pipe style of MD055.",
      "oneOf": [
        {
          "description": "Like the first row.",
          "type": "string",
          "const": "consistent"
        },
        {
          "description": "`| a | b`",
          "type": "string",
          "const": "leading_only"
        },
        {
          "description": "`a | b |`",
          "type": "string",
          "const": "trailing_only"
        },
        {
          "description": "`| a | b |`",
          "type": "string",
          "const": "leading_and_trailing"
        },
        {
          "description": "`a | b`",
          "type": "string",
          "const": "no_leading_or_trailing"
        },
        {
          "description": "Like the first row of each table.",
          "type": "string",
          "const": "per_table"
        }
      ]
    },
    "Md059Options": {
      "description": "Options of MD059 `descriptive-link-text`.",
      "type": "object",
      "properties": {
        "prohibited_texts": {
          "description": "Prohibited link texts.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "click here",
            "here",
            "link",
            "more"
          ]
        }
      },
      "additionalProperties": false
    },
    "Mrq001Options": {
      "description": "Options of MRQ001 `valid-anchors`.",
      "type": "object",
      "properties": {
        "cross_file": {
          "description": "Also check anchors in other Markdown files, read from disk.",
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "Mrq002Options": {
      "description": "Options of MRQ002 `heading-punctuation`.",
      "type": "object",
      "properties": {
        "punctuation": {
          "description": "Characters a heading's text must not end with.",
          "type": "string",
          "default": ".,;:!。，；：！"
        }
      },
      "additionalProperties": false
    },
    "Mrq003Options": {
      "description": "Options of MRQ003 `frontmatter-key-order`.",
      "type": "object",
      "properties": {
        "order": {
          "description": "Keys that come first, in this order.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "alphabetical": {
          "description": "Sort the keys not in `order` by name.",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "FmtConfig": {
      "description": "`fmt` section.",
      "type": "object",
      "properties": {
        "wrap": {
          "description": "Prose wrapping mode.",
          "$ref": "#/$defs/Wrap",
          "default": "preserve"
        },
        "width": {
          "description": "Line width for `wrap: width`.",
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535,
          "default": 80
        },
        "emphasis": {
          "description": "Emphasis marker.",
          "$ref": "#/$defs/Emphasis",
          "default": "*"
        },
        "strong": {
          "description": "Strong emphasis marker.",
          "$ref": "#/$defs/Strong",
          "default": "**"
        },
        "list_marker": {
          "description": "Bullet list marker.",
          "$ref": "#/$defs/ListMarker",
          "default": "-"
        },
        "ordered_list": {
          "description": "Ordered list numbering.",
          "$ref": "#/$defs/OrderedList",
          "default": "ordered"
        },
        "code_fence": {
          "description": "Code fence.",
          "$ref": "#/$defs/CodeFence",
          "default": "```"
        },
        "frontmatter": {
          "description": "Frontmatter handling.",
          "$ref": "#/$defs/FrontmatterFormat",
          "default": "preserve"
        },
        "code_formatters": {
          "description": "External formatters for fenced code, keyed by language: a command and its\narguments, reading the code on stdin and writing the result to stdout.",
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "default": {}
        }
      },
      "additionalProperties": false
    },
    "Wrap": {
      "description": "Prose wrapping mode of `fmt.wrap`.",
      "oneOf": [
        {
          "description": "Keep line breaks as written.",
          "type": "string",
          "const": "preserve"
        },
        {
          "description": "One line per paragraph.",
          "type": "string",
          "const": "never"
        },
        {
          "description": "Wrap at `fmt.width` columns.",
          "type": "string",
          "const": "width"
        },
        {
          "description": "One sentence per line.",
          "type": "string",
          "const": "sentence"
        }
      ]
    },
    "Emphasis": {
      "description": "Emphasis marker of `fmt.emphasis`.",
      "type": "string",
      "enum": [
        "*",
        "_"
      ]
    },
    "Strong": {
      "description": "Strong emphasis marker of `fmt.strong`.",
      "type": "string",
      "enum": [
        "**",
        "__"
      ]
    },
    "ListMarker": {
      "description": "Bullet list marker of `fmt.list_marker`.",
      "type": "string",
      "enum": [
        "-",
        "*",
        "+"
      ]
    },
    "OrderedList": {
      "description": "Ordered list numbering of `fmt.ordered_list`.",
      "oneOf": [
        {
          "description": "Every item is numbered `1.`.",
          "type": "string",
          "const": "one"
        },
        {
          "description": "Items are numbered consecutively from the first number.",
          "type": "string",
          "const": "ordered"
        },
        {
          "description": "Numbers are kept as written.",
          "type": "string",
          "const": "preserve"
        }
      ]
    },
    "CodeFence": {
      "description": "Code fence of `fmt.code_fence`.",
      "type": "string",
      "enum": [
        "```",
        "~~~"
      ]
    },
    "FrontmatterFormat": {
      "description": "Frontmatter handling of `fmt.frontmatter`.",
      "oneOf": [
        {
          "description": "Keep frontmatter bytes verbatim.",
          "type": "string",
          "const": "preserve"
        },
        {
          "description": "Re-serialize frontmatter canonically.",
          "type": "string",
          "const": "normalize"
        }
      ]
    },
    "ValidateConfig": {
      "description": "`validate` section.",
      "type": "object",
      "properties": {
        "external": {
          "description": "Check external http(s) links (also enabled by `--external`).",
          "type": "boolean",
          "default": false
        },
        "external_exclude": {
          "description": "Regular expressions of external URLs never to check.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "frontmatter": {
          "description": "JSON Schemas for frontmatter, per glob.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/FrontmatterSchema"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "FrontmatterSchema": {
      "description": "One `validate.frontmatter` entry.",
      "type": "object",
      "properties": {
        "files": {
          "description": "Glob of the files the schema applies to, relative to the directory of the config\nfile that sets it.",
          "type": "string"
        },
        "schema": {
          "description": "Path of the JSON Schema, relative to the config file that sets it.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "files",
        "schema"
      ]
    },
    "IncludeConfig": {
      "description": "`include` section.",
      "type": "object",
      "properties": {
        "allow_remote": {
          "description": "Allow `mrq:include` from http(s) URLs (needs the `remote-include` feature).",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "RenderConfig": {
      "description": "`render` section.",
      "type": "object",
      "properties": {
        "style": {
          "description": "Built-in theme name (`light`, `dark`, `github`, `paper`) or a theme file path.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "diagrams": {
          "description": "Diagram rendering.",
          "$ref": "#/$defs/DiagramsConfig",
          "default": {
            "kroki": {
              "enabled": false,
              "url": "https://kroki.io"
            },
            "commands": {}
          }
        }
      },
      "additionalProperties": false
    },
    "DiagramsConfig": {
      "description": "`render.diagrams` section.",
      "type": "object",
      "properties": {
        "kroki": {
          "description": "The Kroki diagram service, tried after built-in renderers and commands.",
          "$ref": "#/$defs/KrokiConfig",
          "default": {
            "enabled": false,
            "url": "https://kroki.io"
          }
        },
        "commands": {
          "description": "Custom renderers keyed by fence language: a command and its arguments, reading\nthe diagram source on stdin and writing SVG to stdout.",
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "default": {}
        }
      },
      "additionalProperties": false
    },
    "KrokiConfig": {
      "description": "`render.diagrams.kroki` section.",
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Kroki is never contacted unless this is `true`.",
          "type": "boolean",
          "default": false
        },
        "url": {
          "description": "Base URL of the Kroki service.",
          "type": "string",
          "default": "https://kroki.io"
        }
      },
      "additionalProperties": false
    }
  }
}
