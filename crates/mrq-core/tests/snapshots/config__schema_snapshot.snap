---
source: crates/mrq-core/tests/config.rs
expression: "mrq_core::config::schema_json()"
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mrq configuration (.mrq.yaml)",
  "description": "The effective configuration of mrq (`.mrq.yaml`).",
  "type": "object",
  "properties": {
    "flavor": {
      "description": "Markdown flavor used when neither `--flavor` nor frontmatter `mrq.flavor` picks one.",
      "$ref": "#/$defs/FlavorName",
      "default": "gfm"
    },
    "ignore": {
      "description": "Globs of files and directories to skip when walking directories.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "lint": {
      "description": "`mrq lint` settings.",
      "$ref": "#/$defs/LintConfig",
      "default": {
        "extends": "default",
        "rules": {}
      }
    },
    "fmt": {
      "description": "`mrq fmt` settings.",
      "$ref": "#/$defs/FmtConfig",
      "default": {
        "wrap": "preserve",
        "width": 80,
        "emphasis": "*",
        "strong": "**",
        "list_marker": "-",
        "ordered_list": "ordered",
        "code_fence": "```",
        "frontmatter": "preserve",
        "code_formatters": {}
      }
    },
    "validate": {
      "description": "`mrq validate` settings.",
      "$ref": "#/$defs/ValidateConfig",
      "default": {
        "external": false,
        "external_exclude": [],
        "frontmatter": []
      }
    },
    "include": {
      "description": "`mrq:include` settings.",
      "$ref": "#/$defs/IncludeConfig",
      "default": {
        "allow_remote": false
      }
    },
    "render": {
      "description": "`mrq render` settings.",
      "$ref": "#/$defs/RenderConfig",
      "default": {
        "style": null,
        "diagrams": {
          "kroki": {
            "enabled": false,
            "url": "https://kroki.io"
          },
          "commands": {}
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "FlavorName": {
      "description": "A built-in Markdown flavor.",
      "oneOf": [
        {
          "description": "Strict `CommonMark`.",
          "type": "string",
          "const": "commonmark"
        },
        {
          "description": "GitHub Flavored Markdown.",
          "type": "string",
          "const": "gfm"
        },
        {
          "description": "gfm + wikilinks, embeds, callouts, tags, math, comments.",
          "type": "string",
          "const": "obsidian"
        },
        {
          "description": "gfm + admonitions, heading attributes, definition lists, math, abbreviations.",
          "type": "string",
          "const": "mkdocs"
        }
      ]
    },
    "LintConfig": {
      "description": "`lint` section.",
      "type": "object",
      "properties": {
        "extends": {
          "description": "Base rule set: `default` enables every rule that is on by default, `none` starts empty.",
          "$ref": "#/$defs/LintExtends",
          "default": "default"
        },
        "rules": {
          "description": "Per-rule settings keyed by rule id (`MD013`, `MRQ001`, …), markdownlint alias\n(`line-length`) or tag (`whitespace`): an options object, `off`/`false` to\ndisable, or `on`/`true` to enable with defaults.",
          "$ref": "#/$defs/RuleSettings",
          "default": {}
        }
      },
      "additionalProperties": false
    },
    "LintExtends": {
      "description": "Base rule set of `lint.extends`.",
      "oneOf": [
        {
          "description": "Every rule that is enabled by default.",
          "type": "string",
          "const": "default"
        },
        {
          "description": "No rules; only those listed under `rules` run.",
          "type": "string",
          "const": "none"
        }
      ]
    },
    "RuleSettings": {
      "description": "Per-rule settings keyed by rule id, alias or tag: `true`/`on`, `false`/`off`, or the rule's options.",
      "type": "object",
      "properties": {
        "MD001": {
          "description": "MD001: Heading levels should only increment by one level at a time",
          "anyOf": [
            {
              "$ref": "#/$defs/RuleSwitch"
            },
            {
              "$ref": "#/$defs/Md001Options"
            }
          ]
        },
        "heading-increment": {
          "description": "MD001: Heading levels should only increment by one level at a time",
          "anyOf": [
            {
              "$ref": "#/$defs/RuleSwitch"
            },
            {
              "$ref": "#/$defs/Md001Options"
            }
          ]
        },
        "MD003": {
