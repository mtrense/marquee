---
source: crates/mrq-core/tests/config.rs
expression: "mrq_core::config::schema_json()"
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mrq configuration (.mrq.yaml)",
  "description": "The effective configuration of mrq (`.mrq.yaml`).",
  "type": "object",
  "properties": {
    "flavor": {
      "description": "Markdown flavor used when neither `--flavor` nor frontmatter `mrq.flavor` picks one.",
      "$ref": "#/$defs/FlavorName",
      "default": "gfm"
    },
    "ignore": {
      "description": "Globs of files and directories to skip when walking directories.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "lint": {
      "description": "`mrq lint` settings.",
      "$ref": "#/$defs/LintConfig",
      "default": {
        "extends": "default",
        "rules": {}
      }
    },
    "fmt": {
      "description": "`mrq fmt` settings.",
      "$ref": "#/$defs/FmtConfig",
      "default": {
        "wrap": "preserve",
        "width": 80,
        "emphasis": "*",
        "strong": "**",
        "list_marker": "-",
        "ordered_list": "ordered",
        "code_fence": "```",
        "frontmatter": "preserve",
        "code_formatters": {}
      }
    },
    "validate": {
      "description": "`mrq validate` settings.",
      "$ref": "#/$defs/ValidateConfig",
      "default": {
        "external": false,
        "external_exclude": [],
        "frontmatter": []
      }
    },
    "include": {
      "description": "`mrq:include` settings.",
      "$ref": "#/$defs/IncludeConfig",
      "default": {
        "allow_remote": false
      }
    },
    "render": {
      "description": "`mrq render` settings.",
      "$ref": "#/$defs/RenderConfig",
      "default": {
        "style": null,
        "diagrams": {
          "kroki": {
            "enabled": false,
            "url": "https://kroki.io"
          },
          "commands": {}
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "FlavorName": {
      "description": "A built-in Markdown flavor.",
      "oneOf": [
        {
          "description": "Strict `CommonMark`.",
          "type": "string",
          "const": "commonmark"
        },
        {
          "description": "GitHub Flavored Markdown.",
          "type": "string",
          "const": "gfm"
        },
        {
          "description": "gfm + wikilinks, embeds, callouts, tags, math, comments.",
          "type": "string",
          "const": "obsidian"
        },
        {
          "description": "gfm + admonitions, heading attributes, definition lists, math, abbreviations.",
          "type": "string",
          "const": "mkdocs"
        }
      ]
    },
    "LintConfig": {
      "description": "`lint` section.",
      "type": "object",
      "properties": {
        "extends": {
          "description": "Base rule set: `default` enables every rule that is on by default, `none` starts empty.",
          "$ref": "#/$defs/LintExtends",
          "default": "default"
        },
        "rules": {
          "description": "Per-rule settings keyed by rule id (`MD013`, `MRQ001`, …), markdownlint alias\n(`line-length`) or tag (`whitespace`): an options object, `off`/`false` to\ndisable, or `on`/`true` to enable with defaults.",
          "$ref": "#/$defs/RuleSettings",
          "default": {}
        }
      },
      "additionalProperties": false
    },
    "LintExtends": {
      "description": "Base rule set of `lint.extends`.",
      "oneOf": [
        {
          "description": "Every rule that is enabled by default.",
          "type": "string",
          "const": "default"
        },
        {
          "description": "No rules; only those listed under `rules` run.",
          "type": "string",
          "const": "none"
        }
      ]
    },
    "RuleSettings": {
      "description": "Per-rule settings keyed by rule id, alias or tag: `true`/`on`, `false`/`off`, or the rule's options.",
      "type": "object",
      "properties": {
        "MD001": {
          "description": "MD001: Heading levels should only increment by one level at a time",
          "anyOf": [
            {
              "$ref": "#/$defs/RuleSwitch"
            },
            {
              "$ref": "#/$defs/Md001Options"
            }
          ]
        },
        "heading-increment": {
          "description": "MD001: Heading levels should only increment by one level at a time",
          "anyOf": [
            {
              "$ref": "#/$defs/RuleSwitch"
            },
            {
              "$ref": "#/$defs/Md001Options"
            }
          ]
        },
        "MD003": {
          "description": "MD003: Heading style",
          "anyOf": [
            {
              "$ref": "#/$defs/RuleSwitch"
            },
            {
              "$ref": "#/$defs/Md003Options"
            }
          ]
        },
        "heading-style": {
          "description": "MD003: Heading style",
          "anyOf": [
            {
              "$ref": "#/$defs/RuleSwitch"
            },
            {
              "$ref": "#/$defs/Md003Options"
            }
          ]
        },
        "MD004": {
          "description": "MD004: Unordered list style",
          "anyOf": [
            {
              "$ref": "#/$defs/RuleSwitch"
            },
            {
              "$ref": "#/$defs/Md004Options"
            }
          ]
        },
        "ul-style": {
          "description": "MD004: Unordered list style",
          "anyOf": [
            {
              "$ref": "#/$defs/RuleSwitch"
            },
            {
              "$ref": "#/$defs/Md004Options"
            }
          ]
        },
        "MD005": {
          "description": "MD005: Inconsistent indentation for list items at the same level",
          "anyOf": [
            {
              "$ref": "#/$defs/RuleSwitch"
            },
            {
              "$ref": "#/$defs/NoOptions"
            }
          ]
        },
        "list-indent": {
          "description": "MD005: Inconsistent indentation for list items at the same level",
          "anyOf": [
            {
              "$ref": "#/$defs/RuleSwitch"
            },
            {
              "$ref": "#/$defs/NoOptions"
            }
          ]
        },
        "MD007": {
          "description": "MD007: Unordered list indentation",
          "anyOf": [
            {
              "$ref": "#/$defs/RuleSwitch"
            },
            {
              "$ref": "#/$defs/Md007Options"
            }
          ]
        },
        "ul-indent": {
          "description": "MD007: Unordered list indentation",
          "anyOf": [
            {
              "$ref": "#/$defs/RuleSwitch"
            },
            {
              "$ref": "#/$defs/Md007Options"
            }
          ]
        },
        "MD009": {
          "description": "MD009: Trailing spaces",
          "anyOf": [
            {
              "$ref": "#/$defs/RuleSwitch"
            },
            {
              "$ref": "#/$defs/Md009Options"
            }
          ]
        },
        "no-trailing-spaces": {
          "description": "MD009: Trailing spaces",
          "anyOf": [
            {
              "$ref": "#/$defs/RuleSwitch"
            },
            {
              "$ref": "#/$defs/Md009Options"
            }
          ]
        },
        "MD010": {
          "description": "MD010: Hard tabs",
          "anyOf": [
            {
              "$ref": "#/$defs/RuleSwitch"
            },
            {
              "$ref": "#/$defs/Md010Options"
            }
          ]
        },
        "no-hard-tabs": {
          "description": "MD010: Hard tabs",
          "anyOf": [
            {
              "$ref": "#/$defs/RuleSwitch"
            },
            {
              "$ref": "#/$defs/Md010Options"
            }
          ]
        },
        "MD011": {
          "description": "MD011: Reversed link syntax",
          "anyOf": [
            {
              "$ref": "#/$defs/RuleSwitch"
            },
            {
              "$ref": "#/$defs/NoOptions"
            }
          ]
        },
        "no-reversed-links": {
          "description": "MD011: Reversed link syntax",
          "anyOf": [
            {
              "$ref": "#/$defs/RuleSwitch"
            },
            {
              "$ref": "#/$defs/NoOptions"
            }
          ]
        },
        "MD012": {
          "description": "MD012: Multiple consecutive blank lines",
          "anyOf": [
            {
              "$ref": "#/$defs/RuleSwitch"
            },
            {
              "$ref": "#/$defs/Md012Options"
            }
          ]
        },
        "no-multiple-blanks": {
          "description": "MD012: Multiple consecutive blank lines",
          "anyOf": [
            {
              "$ref": "#/$defs/RuleSwitch"
            },
            {
              "$ref": "#/$defs/Md012Options"
            }
          ]
        },
        "MD013": {
          "description": "MD013: Line length",
          "anyOf": [
            {
              "$ref": "#/$defs/RuleSwitch"
            },
            {
              "$ref": "#/$defs/Md013Options"
            }
          ]
        },
        "line-length": {
          "description": "MD013: Line length",
          "anyOf": [
            {
              "$ref": "#/$defs/RuleSwitch"
            },
            {
              "$ref": "#/$defs/Md013Options"
            }
          ]
        },
        "MD014": {
          "description": "MD014: Dollar signs used before commands without showing output",
          "anyOf": [
            {
              "$ref": "#/$defs/RuleSwitch"
            },
            {
              "$ref": "#/$defs/NoOptions"
            }
          ]
        },
        "commands-show-output": {
          "description": "MD014: Dollar signs used before commands without showing output",
          "anyOf": [
            {
              "$ref": "#/$defs/RuleSwitch"
            },
            {
              "$ref": "#/$defs/NoOptions"
            }
          ]
        },
        "MD018": {
          "description": "MD018: No space after hash on atx style heading",
          "anyOf": [
            {
              "$ref": "#/$defs/RuleSwitch"
            },
            {
              "$ref": "#/$defs/NoOptions"
            }
          ]
        },
        "no-missing-space-atx": {
          "description": "MD018: No space after hash on atx style heading",
          "anyOf": [
            {
              "$ref": "#/$defs/RuleSwitch"
            },
            {
              "$ref": "#/$defs/NoOptions"
            }
          ]
        },
        "MD019": {
          "description": "MD019: Multiple spaces after hash on atx style heading",
          "anyOf": [
            {
              "$ref": "#/$defs/RuleSwitch"
            },
            {
              "$ref": "#/$defs/NoOptions"
            }
          ]
        },
        "no-multiple-space-atx": {
          "description": "MD019: Multiple spaces after hash on atx style heading",
          "anyOf": [
            {
              "$ref": "#/$defs/RuleSwitch"
            },
            {
              "$ref": "#/$defs/NoOptions"
            }
          ]
        },
        "MD020": {
          "description": "MD020: No space inside hashes on closed atx style heading",
          "anyOf": [
            {
              "$ref": "#/$defs/RuleSwitch"
            },
            {
              "$ref": "#/$defs/NoOptions"
            }
          ]
        },
        "no-missing-space-closed-atx": {
          "description": "MD020: No space inside hashes on closed atx style heading",
          "anyOf": [
            {
              "$ref": "#/$defs/RuleSwitch"
            },
            {
              "$ref": "#/$defs/NoOptions"
            }
          ]
        },
        "MD047": {
          "description": "MD047: Files should end with a single newline character",
          "anyOf": [
            {
              "$ref": "#/$defs/RuleSwitch"
            },
            {
              "$ref": "#/$defs/NoOptions"
            }
          ]
        },
        "single-trailing-newline": {
          "description": "MD047: Files should end with a single newline character",
          "anyOf": [
            {
              "$ref": "#/$defs/RuleSwitch"
            },
            {
              "$ref": "#/$defs/NoOptions"
            }
          ]
        },
        "atx": {
          "description": "Every rule tagged `atx`",
          "allOf": [
            {
              "$ref": "#/$defs/RuleSwitch"
            }
          ]
        },
        "atx_closed": {
          "description": "Every rule tagged `atx_closed`",
          "allOf": [
            {
              "$ref": "#/$defs/RuleSwitch"
            }
          ]
        },
        "blank_lines": {
          "description": "Every rule tagged `blank_lines`",
          "allOf": [
            {
              "$ref": "#/$defs/RuleSwitch"
            }
          ]
        },
        "bullet": {
          "description": "Every rule tagged `bullet`",
          "allOf": [
            {
              "$ref": "#/$defs/RuleSwitch"
            }
          ]
        },
        "code": {
          "description": "Every rule tagged `code`",
          "allOf": [
            {
              "$ref": "#/$defs/RuleSwitch"
            }
          ]
        },
        "hard_tab": {
          "description": "Every rule tagged `hard_tab`",
          "allOf": [
            {
              "$ref": "#/$defs/RuleSwitch"
            }
          ]
        },
        "headings": {
          "description": "Every rule tagged `headings`",
          "allOf": [
            {
              "$ref": "#/$defs/RuleSwitch"
            }
          ]
        },
        "indentation": {
          "description": "Every rule tagged `indentation`",
          "allOf": [
            {
              "$ref": "#/$defs/RuleSwitch"
            }
          ]
        },
        "line_length": {
          "description": "Every rule tagged `line_length`",
          "allOf": [
            {
              "$ref": "#/$defs/RuleSwitch"
            }
          ]
        },
        "links": {
          "description": "Every rule tagged `links`",
          "allOf": [
            {
              "$ref": "#/$defs/RuleSwitch"
            }
          ]
        },
        "spaces": {
          "description": "Every rule tagged `spaces`",
          "allOf": [
            {
              "$ref": "#/$defs/RuleSwitch"
            }
          ]
        },
        "ul": {
          "description": "Every rule tagged `ul`",
          "allOf": [
            {
              "$ref": "#/$defs/RuleSwitch"
            }
          ]
        },
        "whitespace": {
          "description": "Every rule tagged `whitespace`",
          "allOf": [
            {
              "$ref": "#/$defs/RuleSwitch"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "RuleSwitch": {
      "description": "`true`/`on` enables, `false`/`off` disables.",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "enum": [
            "on",
            "off"
          ]
        }
      ]
    },
    "Md001Options": {
      "description": "Options of MD001 `heading-increment`.",
      "type": "object",
      "properties": {
        "front_matter_title": {
          "description": "Regular expression (case-insensitive) for a frontmatter line that holds the\ntitle; `\"\"` ignores the frontmatter. An invalid expression matches nothing.",
          "type": "string",
          "default": "^\\s*\"?title\"?\\s*[:=]"
        }
      },
      "additionalProperties": false
    },
    "Md003Options": {
      "description": "Options of MD003 `heading-style`.",
      "type": "object",
      "properties": {
        "style": {
          "description": "Heading style.",
          "$ref": "#/$defs/HeadingStyle",
          "default": "consistent"
        }
      },
      "additionalProperties": false
    },
    "HeadingStyle": {
      "description": "A heading style of MD003.",
      "oneOf": [
        {
          "description": "Like the first heading.",
          "type": "string",
          "const": "consistent"
        },
        {
          "description": "`# Heading`",
          "type": "string",
          "const": "atx"
        },
        {
          "description": "`# Heading #`",
          "type": "string",
          "const": "atx_closed"
        },
        {
          "description": "Underlined with `===` or `---`.",
          "type": "string",
          "const": "setext"
        },
        {
          "description": "Setext for levels 1 and 2, `atx` below.",
          "type": "string",
          "const": "setext_with_atx"
        },
        {
          "description": "Setext for levels 1 and 2, `atx_closed` below.",
          "type": "string",
          "const": "setext_with_atx_closed"
        }
      ]
    },
    "Md004Options": {
      "description": "Options of MD004 `ul-style`.",
      "type": "object",
      "properties": {
        "style": {
          "description": "List style.",
          "$ref": "#/$defs/ListStyle",
          "default": "consistent"
        }
      },
      "additionalProperties": false
    },
    "ListStyle": {
      "description": "A bullet list style of MD004.",
      "oneOf": [
        {
          "description": "Like the first marker.",
          "type": "string",
          "const": "consistent"
        },
        {
          "description": "`*`",
          "type": "string",
          "const": "asterisk"
        },
        {
          "description": "`+`",
          "type": "string",
          "const": "plus"
        },
        {
          "description": "`-`",
          "type": "string",
          "const": "dash"
        },
        {
          "description": "Each nesting level differs from its parent.",
          "type": "string",
          "const": "sublist"
        }
      ]
    },
    "NoOptions": {
      "description": "Options of a rule that has none: only `{}` is accepted.",
      "type": "object",
      "additionalProperties": false
    },
    "Md007Options": {
      "description": "Options of MD007 `ul-indent`.",
      "type": "object",
      "properties": {
        "indent": {
          "description": "Spaces for indent.",
          "type": "integer",
          "format": "uint",
          "minimum": 1,
          "default": 2
        },
        "start_indented": {
          "description": "Whether to indent the first level of the list.",
          "type": "boolean",
          "default": false
        },
        "start_indent": {
          "description": "Spaces for first level indent (when `start_indented` is set); defaults to\n`indent`.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 1,
          "default": null
        }
      },
      "additionalProperties": false
    },
    "Md009Options": {
      "description": "Options of MD009 `no-trailing-spaces`.",
      "type": "object",
      "properties": {
        "br_spaces": {
          "description": "Spaces for line break (values below 2 allow none).",
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 2
        },
        "code_blocks": {
          "description": "Include code blocks.",
          "type": "boolean",
          "default": false
        },
        "list_item_empty_lines": {
          "description": "Allow spaces for empty lines in list items.",
          "type": "boolean",
          "default": false
        },
        "strict": {
          "description": "Include unnecessary breaks.",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "Md010Options": {
      "description": "Options of MD010 `no-hard-tabs`.",
      "type": "object",
      "properties": {
        "code_blocks": {
          "description": "Include code blocks.",
          "type": "boolean",
          "default": true
        },
        "ignore_code_languages": {
          "description": "Fenced code languages to ignore (ignoring case). Like markdownlint, a non-empty\nlist also skips fenced blocks without a language.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "spaces_per_tab": {
          "description": "Number of spaces for each hard tab.",
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 1
        }
      },
      "additionalProperties": false
    },
    "Md012Options": {
      "description": "Options of MD012 `no-multiple-blanks`.",
      "type": "object",
      "properties": {
        "maximum": {
          "description": "Consecutive blank lines allowed.",
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 1
        }
      },
      "additionalProperties": false
    },
    "Md013Options": {
      "description": "Options of MD013 `line-length`.",
      "type": "object",
      "properties": {
        "line_length": {
          "description": "Number of characters.",
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 80
        },
        "heading_line_length": {
          "description": "Number of characters for headings; defaults to `line_length`.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0,
          "default": null
        },
        "code_block_line_length": {
          "description": "Number of characters for code blocks; defaults to `line_length`.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0,
          "default": null
        },
        "code_blocks": {
          "description": "Include code blocks.",
          "type": "boolean",
          "default": true
        },
        "tables": {
          "description": "Include tables.",
          "type": "boolean",
          "default": true
        },
        "headings": {
          "description": "Include headings.",
          "type": "boolean",
          "default": true
        },
        "strict": {
          "description": "Strict length checking.",
          "type": "boolean",
          "default": false
        },
        "stern": {
          "description": "Stern length checking.",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "FmtConfig": {
      "description": "`fmt` section.",
      "type": "object",
      "properties": {
        "wrap": {
          "description": "Prose wrapping mode.",
          "$ref": "#/$defs/Wrap",
          "default": "preserve"
        },
        "width": {
          "description": "Line width for `wrap: width`.",
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535,
          "default": 80
        },
        "emphasis": {
          "description": "Emphasis marker.",
          "$ref": "#/$defs/Emphasis",
          "default": "*"
        },
        "strong": {
          "description": "Strong emphasis marker.",
          "$ref": "#/$defs/Strong",
          "default": "**"
        },
        "list_marker": {
          "description": "Bullet list marker.",
          "$ref": "#/$defs/ListMarker",
          "default": "-"
        },
        "ordered_list": {
          "description": "Ordered list numbering.",
          "$ref": "#/$defs/OrderedList",
          "default": "ordered"
        },
        "code_fence": {
          "description": "Code fence.",
          "$ref": "#/$defs/CodeFence",
          "default": "```"
        },
        "frontmatter": {
          "description": "Frontmatter handling.",
          "$ref": "#/$defs/FrontmatterFormat",
          "default": "preserve"
        },
        "code_formatters": {
          "description": "External formatters for fenced code, keyed by language: a command and its\narguments, reading the code on stdin and writing the result to stdout.",
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "default": {}
        }
      },
      "additionalProperties": false
    },
    "Wrap": {
      "description": "Prose wrapping mode of `fmt.wrap`.",
      "oneOf": [
        {
          "description": "Keep line breaks as written.",
          "type": "string",
          "const": "preserve"
        },
        {
          "description": "One line per paragraph.",
          "type": "string",
          "const": "never"
        },
        {
          "description": "Wrap at `fmt.width` columns.",
          "type": "string",
          "const": "width"
        },
        {
          "description": "One sentence per line.",
          "type": "string",
          "const": "sentence"
        }
      ]
    },
    "Emphasis": {
      "description": "Emphasis marker of `fmt.emphasis`.",
      "type": "string",
      "enum": [
        "*",
        "_"
      ]
    },
    "Strong": {
      "description": "Strong emphasis marker of `fmt.strong`.",
      "type": "string",
      "enum": [
        "**",
        "__"
      ]
    },
    "ListMarker": {
      "description": "Bullet list marker of `fmt.list_marker`.",
      "type": "string",
      "enum": [
        "-",
        "*",
        "+"
      ]
    },
    "OrderedList": {
      "description": "Ordered list numbering of `fmt.ordered_list`.",
      "oneOf": [
        {
          "description": "Every item is numbered `1.`.",
          "type": "string",
          "const": "one"
        },
        {
          "description": "Items are numbered consecutively from the first number.",
          "type": "string",
          "const": "ordered"
        },
        {
          "description": "Numbers are kept as written.",
          "type": "string",
          "const": "preserve"
        }
      ]
    },
    "CodeFence": {
      "description": "Code fence of `fmt.code_fence`.",
      "type": "string",
      "enum": [
        "```",
        "~~~"
      ]
    },
    "FrontmatterFormat": {
      "description": "Frontmatter handling of `fmt.frontmatter`.",
      "oneOf": [
        {
          "description": "Keep frontmatter bytes verbatim.",
          "type": "string",
          "const": "preserve"
        },
        {
          "description": "Re-serialize frontmatter canonically.",
          "type": "string",
          "const": "normalize"
        }
      ]
    },
    "ValidateConfig": {
      "description": "`validate` section.",
      "type": "object",
      "properties": {
        "external": {
          "description": "Check external http(s) links (also enabled by `--external`).",
          "type": "boolean",
          "default": false
        },
        "external_exclude": {
          "description": "Regular expressions of external URLs never to check.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "frontmatter": {
          "description": "JSON Schemas for frontmatter, per glob.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/FrontmatterSchema"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "FrontmatterSchema": {
      "description": "One `validate.frontmatter` entry.",
      "type": "object",
      "properties": {
        "files": {
          "description": "Glob of the files the schema applies to, relative to the directory of the config\nfile that sets it.",
          "type": "string"
        },
        "schema": {
          "description": "Path of the JSON Schema, relative to the config file that sets it.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "files",
        "schema"
      ]
    },
    "IncludeConfig": {
      "description": "`include` section.",
      "type": "object",
      "properties": {
        "allow_remote": {
          "description": "Allow `mrq:include` from http(s) URLs (needs the `remote-include` feature).",
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "RenderConfig": {
      "description": "`render` section.",
      "type": "object",
      "properties": {
        "style": {
          "description": "Built-in theme name (`light`, `dark`, `github`, `paper`) or a theme file path.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "diagrams": {
          "description": "Diagram rendering.",
          "$ref": "#/$defs/DiagramsConfig",
          "default": {
            "kroki": {
              "enabled": false,
              "url": "https://kroki.io"
            },
            "commands": {}
          }
        }
      },
      "additionalProperties": false
    },
    "DiagramsConfig": {
      "description": "`render.diagrams` section.",
      "type": "object",
      "properties": {
        "kroki": {
          "description": "The Kroki diagram service, tried after built-in renderers and commands.",
          "$ref": "#/$defs/KrokiConfig",
          "default": {
            "enabled": false,
            "url": "https://kroki.io"
          }
        },
        "commands": {
          "description": "Custom renderers keyed by fence language: a command and its arguments, reading\nthe diagram source on stdin and writing SVG to stdout.",
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "default": {}
        }
      },
      "additionalProperties": false
    },
    "KrokiConfig": {
      "description": "`render.diagrams.kroki` section.",
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Kroki is never contacted unless this is `true`.",
          "type": "boolean",
          "default": false
        },
        "url": {
          "description": "Base URL of the Kroki service.",
          "type": "string",
          "default": "https://kroki.io"
        }
      },
      "additionalProperties": false
    }
  }
}
