document 0..229  @ "Inline $e^{i\\pi} + 1 = 0$ and display $$\\sum_{k=1}^n k$$ in a sentence.\n\n$$\n\\begin{aligned}\na &= b \\\\\nc &= d\n\\end{aligned}\n$$\n\nPrices $5 and $6 stay text; ==highlighted== too.\n\nMath hides syntax: $[[x]] \\# %%y%%$ and #tag after.\n"
  paragraph 0..71  @ "Inline $e^{i\\pi} + 1 = 0$ and display $$\\sum_{k=1}^n k$$ in a sentence."
    text 0..7 "Inline "  @ "Inline "
    math 7..25 { display: false, literal: "e^{i\\pi} + 1 = 0" }  @ "$e^{i\\pi} + 1 = 0$"
    text 25..38 " and display "  @ " and display "
    math 38..56 { display: true, literal: "\\sum_{k=1}^n k" }  @ "$$\\sum_{k=1}^n k$$"
    text 56..71 " in a sentence."  @ " in a sentence."
  paragraph 73..125  @ "$$\n\\begin{aligned}\na &= b \\\\\nc &= d\n\\end{aligned}\n$$"
    math 73..125 { display: true, literal: "\n\\begin{aligned}\na &= b \\\\\nc &= d\n\\end{aligned}\n" }  @ "$$\n\\begin{aligned}\na &= b \\\\\nc &= d\n\\end{aligned}\n$$"
  paragraph 127..175  @ "Prices $5 and $6 stay text; ==highlighted== too."
    text 127..155 "Prices $5 and $6 stay text; "  @ "Prices $5 and $6 stay text; "
    highlight 155..170  @ "==highlighted=="
      text 157..168 "highlighted"  @ "highlighted"
    text 170..175 " too."  @ " too."
  paragraph 177..228  @ "Math hides syntax: $[[x]] \\# %%y%%$ and #tag after."
    text 177..196 "Math hides syntax: "  @ "Math hides syntax: "
    math 196..212 { display: false, literal: "[[x]] \\# %%y%%" }  @ "$[[x]] \\# %%y%%$"
